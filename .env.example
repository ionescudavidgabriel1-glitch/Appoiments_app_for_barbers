# Copy to .env and fill in. Never commit .env.

# development | testing | production
APP_ENV=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Defaults to a SQLite file in backend/instance/ when unset.
# Production example: postgresql+psycopg://user:password@host:5432/barbershop
DATABASE_URL=

# Where the app is reachable. Used for links in reminder emails.
APP_BASE_URL=http://127.0.0.1:5000

# Email. Leave SMTP_HOST empty in development: emails are saved as .eml files
# in backend/instance/outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=Barbershop Appointments <no-reply@example.com>
